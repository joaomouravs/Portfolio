# Copie para .env.local e preencha. O .env.local está no .gitignore —
# nenhuma dessas chaves pode entrar no repositório.

# Envio do formulário de contato (https://resend.com).
# Sem estas duas variáveis o formulário responde com um erro pedindo que a
# pessoa escreva direto no e-mail, em vez de fingir que enviou.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=contato@seudominio.com
